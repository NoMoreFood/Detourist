<UserControl x:Class="Detourist.Desktop.ParameterGrid" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto"
            /></Grid.RowDefinitions>
        <DockPanel Margin="6,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox x:Name="RawCheck" Content="Raw slots" Click="RawSlotsChanged" Visibility="Collapsed"
                          Margin="0,0,7,0"
                          ToolTip="Show recorded ABI slots beyond the arguments described by the format" />
                <CheckBox x:Name="TypesCheck" Content="Types" IsChecked="True" Click="TypesChanged"
                          Margin="0,0,7,0"
                          ToolTip="Show parameter types in the grid" />
                <CheckBox x:Name="HexCheck" Content="Hex" IsChecked="True" Click="FormatChanged" Margin="0,0,7,0"
                          ToolTip="Display numeric values in hexadecimal" />
                <Button Content="+" Click="ExpandAll" Padding="5,0" MinHeight="20" ToolTip="Expand all properties"
                        AutomationProperties.Name="Expand all properties" />
                <Button Content="−" Click="CollapseAll" Padding="5,0" MinHeight="20" Margin="3,0,0,0"
                        ToolTip="Collapse all properties" AutomationProperties.Name="Collapse all properties" />
            </StackPanel>
            <TextBlock x:Name="ModeText" Text="Read only" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Grid Grid.Row="1">
            <DataGrid x:Name="PropertiesGrid" CanUserSortColumns="False" CanUserReorderColumns="False"
                      SelectionChanged="PropertySelected" PreviewKeyDown="PropertyKeyDown"
                      MouseDoubleClick="PropertyDoubleClick" AutomationProperties.Name="Parameter property grid">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Property" Width="125" MinWidth="95"
                                            ClipboardContentBinding="{Binding Name}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel Margin="{Binding Indent}" ToolTip="{Binding Name}">
                                    <Button DockPanel.Dock="Left" Content="{Binding ExpandGlyph}"
                                        Click="ToggleExpansion"
                                            Width="14" MinHeight="17" Padding="0"
                                            Focusable="False" IsEnabled="{Binding CanExpand}"
                                            AutomationProperties.Name="Expand property">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanExpand}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="TypeColumn" Header="Type" Binding="{Binding TypeName}"
                                        Width="100" MinWidth="65" Visibility="Visible">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="InputColumn" Header="Input" Binding="{Binding InputText}" Width="*"
                                        MinWidth="85" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn x:Name="OutputColumn" Header="Output" Binding="{Binding OutputText}" Width="*"
                                        MinWidth="85" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn x:Name="ValueColumn" Header="Value" Binding="{Binding ValueText}" Width="*"
                                        MinWidth="150" Visibility="Collapsed"
                                        ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns>
                <DataGrid.Resources>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Modified}" Value="True">
                                <Setter Property="Background" Value="#293D4E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Background" Value="#422B2D" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Text="No parameters loaded" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" TextWrapping="Wrap" />
        </Grid>
        <Border Grid.Row="2" x:Name="EditorPanel" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="7" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="EditorTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"
                    />
                <Grid Grid.Row="1" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="InterpretCombo" SelectionChanged="InterpretChanged" Margin="0,0,5,0"
                              ToolTip="Presumed data type; overrides affect interpretation of this value"
                              AutomationProperties.Name="Parameter data type" />
                    <ComboBox Grid.Column="1" x:Name="NumberFormat" SelectionChanged="NumberFormatChanged"
                              AutomationProperties.Name="Numeric format" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="FlagsButton" Content="Bits…" Click="EditFlags" Margin="5,0,0,0"
                            Visibility="Collapsed" />
                        <Button x:Name="BufferButton" Content="Buffer…" Click="ViewBuffer" Margin="5,0,0,0"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*"
                        /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="NumberInput" TextChanged="NumberEdited" SizeChanged="ValueResized"
                             FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Parameter value" />
                    <ComboBox x:Name="ChoiceInput" Grid.Column="1" DisplayMemberPath="Label"
                        SelectionChanged="ChoiceEdited"
                              Margin="5,0,0,0"
                              Visibility="Collapsed" AutomationProperties.Name="Parameter choices" />
                    <Button x:Name="ExpandValueButton" Grid.Row="1" Grid.ColumnSpan="2" Content="More"
                            HorizontalAlignment="Right" MinHeight="20" Padding="6,0" Margin="0,3,0,0"
                            Click="ExpandValue" Visibility="Collapsed" ToolTip="Expand or collapse the selected value"
                            AutomationProperties.Name="Expand or collapse the selected value" />
                </Grid>
                <TextBlock Grid.Row="3" x:Name="EditorNote" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
