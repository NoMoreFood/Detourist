<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <AssemblyName>Detourist</AssemblyName>
    <RootNamespace>Detourist.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Detourist.ico</ApplicationIcon>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Detourist.ico" />
    <Content Include="../catalog/ApiCatalog.sqlite" Link="ApiCatalog.sqlite" CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../Build/Temp/x64/bin/$(Configuration)/DetouristSqlite.dll" Link="DetouristSqlite.dll"
      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
      Condition="Exists('../../Build/Temp/x64/bin/$(Configuration)/DetouristSqlite.dll')" />
  </ItemGroup>
</Project>
