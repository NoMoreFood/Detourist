add_executable(DetouristHookTests Test/RuntimeTests.cpp)
target_compile_definitions(DetouristHookTests PRIVATE DETOURIST_TEST_DetouristHookTests)
target_include_directories(DetouristHookTests PRIVATE Source/agent)
target_link_libraries(DetouristHookTests PRIVATE detourist_test_support detours advapi32)
target_compile_options(DetouristHookTests PRIVATE /guard:cf)
target_link_options(DetouristHookTests PRIVATE /guard:cf)
add_test(NAME hooks COMMAND DetouristHookTests)
set_tests_properties(hooks PROPERTIES TIMEOUT 15)
foreach(scenario churn denied granted cfg)
    add_test(NAME hooks_${scenario} COMMAND DetouristHookTests --${scenario})
    set_tests_properties(hooks_${scenario} PROPERTIES TIMEOUT 30 RUN_SERIAL TRUE)
endforeach()

foreach(mode Import Delay Dynamic)
    add_executable(Detourist${mode}LoadingTests Test/HookLoadingTests.cpp)
    target_include_directories(Detourist${mode}LoadingTests PRIVATE Source/common)
    target_compile_definitions(Detourist${mode}LoadingTests PRIVATE UNICODE _UNICODE WIN32_LEAN_AND_MEAN NOMINMAX)
    target_compile_options(Detourist${mode}LoadingTests PRIVATE ${detourist_cxx_options})
    if(NOT mode STREQUAL Dynamic)
        target_link_libraries(Detourist${mode}LoadingTests PRIVATE advapi32 version)
    endif()
endforeach()
target_compile_definitions(DetouristDelayLoadingTests PRIVATE DETOURIST_DELAY_IMPORT)
target_link_libraries(DetouristDelayLoadingTests PRIVATE delayimp)
target_link_options(DetouristDelayLoadingTests PRIVATE /DELAYLOAD:advapi32.dll /DELAYLOAD:version.dll /DELAY:UNLOAD)
target_compile_definitions(DetouristDynamicLoadingTests PRIVATE DETOURIST_DYNAMIC_IMPORT)

set(detourist_loading_command ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/Test/HookLoadingTests.py
    $<TARGET_FILE:DetouristCollector> $<TARGET_FILE:DetouristImportLoadingTests>
    $<TARGET_FILE:DetouristDelayLoadingTests> $<TARGET_FILE:DetouristDynamicLoadingTests>)
add_test(NAME hook_loading COMMAND ${detourist_loading_command})
set_tests_properties(hook_loading PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
if(DETOURIST_BUILD_INSTRUCTION_ENGINE)
    add_test(NAME hook_loading_instructions COMMAND ${detourist_loading_command} --instructions)
    set_tests_properties(hook_loading_instructions PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
endif()
